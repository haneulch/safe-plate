# 한국관광공사 TourAPI 4.0 서비스 키 (data.go.kr 발급, 디코딩된 키)
# 비어 있으면 mock(데모) 데이터로 동작합니다.
TOUR_API_KEY=

# 식품안전나라 OpenAPI 키 (foodsafetykorea.go.kr 발급, C005/C002)
# 비어 있으면 바코드 스캔이 데모 바코드만 지원합니다.
MFDS_API_KEY=

# ── Supabase (없으면 data/profile-stats.jsonl 파일 폴백) ──
# 서버 전용 — 통계 insert(service role). 절대 NEXT_PUBLIC_ 금지.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 브라우저용 — Auth(Google 로그인, 프로필 동기화). anon key는 공개 가능한 값.
# 빌드 시점 인라인 — Docker 빌드는 build args로 주입 (GitHub repo Variables).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
